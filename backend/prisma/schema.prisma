

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
  OPERATOR
}


model User {
  id           String    @id @default(uuid())
  name         String
  email        String    @unique
  phone        String
  password     String
  role         Role      @default(USER)
  createdAt    DateTime  @default(now())
}
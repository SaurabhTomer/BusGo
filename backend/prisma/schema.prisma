generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
  OPERATOR
}

enum BusType {
  SEATER
  SLEEPER
}

enum TripStatus {
  SCHEDULED
  CANCELLED
  COMPLETED
}

enum OperatorStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

model User {
  id        String    @id @default(uuid())
  name      String
  email     String    @unique
  phone     String    @unique
  password  String
  role      Role      @default(USER)
  operator  Operator?
  createdAt DateTime  @default(now())
}

model Bus {
  id         String   @id @default(uuid())
  name       String
  busNumber  String   @unique
  type       BusType  @default(SEATER)
  totalSeats Int
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())

  operatorId String
  operator   Operator @relation(fields: [operatorId], references: [id])

  seats Seat[]
  trips Trip[]
}

model Operator {
  id              String         @id @default(uuid())
  userId          String         @unique
  agencyName      String
  gstNo           String         @unique
  contactPhone    String
  address         String
  status          OperatorStatus @default(PENDING)
  rejectionReason String?
  commissionPct   Int            @default(10)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  user   User    @relation(fields: [userId], references: [id])
  buses  Bus[]
  routes Route[]
}

model Seat {
  id         String @id @default(uuid())
  busId      String
  seatNumber String
  row        Int
  col        Int

  bus Bus @relation(fields: [busId], references: [id], onDelete: Cascade) // bus delete hui to seats bhi

  @@unique([busId, seatNumber]) // ek bus me ek seat number do baar nahi
}

model Route {
  id                String @id @default(uuid())
  operatorId        String
  sourceCityId      String
  destinationCityId String
  distanceKm        Int? // optional

  operator        Operator @relation(fields: [operatorId], references: [id])
  sourceCity      City     @relation("RouteSource", fields: [sourceCityId], references: [id])
  destinationCity City     @relation("RouteDestination", fields: [destinationCityId], references: [id])
  trips           Trip[]

  @@unique([operatorId, sourceCityId, destinationCityId]) // ek operator ka wahi route dobara nahi
}

model City {
  id        String   @id @default(uuid())
  name      String // display ke liye: "Lucknow"
  slug      String   @unique // "lucknow" (Lucknow/lucknow dono duplicate na ban paayein)
  state     String? // optional: "Uttar Pradesh"
  isActive  Boolean  @default(true) // remove = band karna (delete nahi)
  createdAt DateTime @default(now())

  routesFrom Route[] @relation("RouteSource")
  routesTo   Route[] @relation("RouteDestination")
}

model Trip {
  id            String     @id @default(uuid())
  busId         String
  routeId       String
  departureTime DateTime
  arrivalTime   DateTime
  price         Int // per seat, rupees me (Razorpay ke liye paise = price * 100)
  status        TripStatus @default(SCHEDULED)
  createdAt     DateTime   @default(now())

  bus   Bus   @relation(fields: [busId], references: [id])
  route Route @relation(fields: [routeId], references: [id])

  @@index([routeId, departureTime]) // search (route + date) fast karne ke liye
}
